// Prisma Schema for RevenueAI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  businessType     String
  monthlyTarget    Float             @default(1500000.0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  users            User[]
  customers        Customer[]
  products         Product[]
  transactions     Transaction[]
  revenueLeaks     RevenueLeak[]
  forecasts        Forecast[]
  churnPredictions ChurnPrediction[]
  aiRecommendations AIRecommendation[]
  notifications    Notification[]
  revenueTargets   RevenueTarget[]
  auditLogs        AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String
  name           String
  role           String       @default("OWNER") // "OWNER" | "MANAGER" | "STAFF"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  auditLogs      AuditLog[]

  @@index([organizationId])
}

model Customer {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  location         String?
  customerSince    DateTime          @default(now())
  totalRevenue     Float             @default(0.0)
  lastPurchaseDate DateTime?
  status           String            @default("NEW") // "ACTIVE" | "AT_RISK" | "CHURNED" | "VIP" | "NEW"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  transactions     Transaction[]
  churnPredictions ChurnPrediction[]

  @@index([organizationId])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  description    String?
  price          Float
  cost           Float
  stock          Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  transactions   Transaction[]

  @@index([organizationId])
}

model Transaction {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  salespersonId   String?
  quantity        Int
  unitPrice       Float
  grossAmount     Float
  discount        Float         @default(0.0) // Percentage or amount
  tax             Float         @default(0.0)
  refundAmount    Float         @default(0.0)
  netRevenue      Float
  costAmount      Float
  grossProfit     Float
  profitMargin    Float
  paymentStatus   String        @default("PAID") // "PAID" | "PENDING" | "FAILED" | "REFUNDED" | "PARTIALLY_REFUNDED"
  paymentMethod   String        @default("CARD") // "CASH" | "CARD" | "UPI" | "BANK_TRANSFER" | "OTHER"
  transactionDate DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  revenueLeaks    RevenueLeak[]

  @@index([organizationId])
  @@index([customerId])
  @@index([productId])
  @@index([transactionDate])
}

model RevenueLeak {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  type           String       // e.g. "EXCESSIVE_DISCOUNT", "FAILED_PAYMENT", "PRICING_ANOMALY"
  amount         Float
  severity       String       @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  description    String
  status         String       @default("OPEN") // "OPEN" | "RESOLVED"
  detectedDate   DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Forecast {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodDate       DateTime
  predictedRevenue Float
  lowerBound       Float
  upperBound       Float
  confidence       Float        @default(0.95)
  modelVersion     String       @default("v1.0")
  createdAt        DateTime     @default(now())

  @@index([organizationId])
}

model ChurnPrediction {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  churnProbability Float
  riskLevel        String       @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  keyFactors       String       // JSON string array of reasons
  predictedDate    DateTime     @default(now())

  @@index([organizationId])
  @@index([customerId])
}

model AIRecommendation {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  explanation     String
  priority        String       @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  potentialImpact Float?
  category        String       // "DISCOUNT", "CHURN", "PRICING", "TARGET"
  status          String       @default("ACTIVE") // "ACTIVE" | "APPLIED" | "DISMISSED"
  createdAt       DateTime     @default(now())

  @@index([organizationId])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           String       // "LEAKAGE", "CHURN", "FORECAST", "SYSTEM"
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RevenueTarget {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  targetAmount       Float
  currentAmount      Float        @default(0.0)
  achievementPercent Float        @default(0.0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@unique([organizationId, year, month])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String
  entity         String
  entityId       String?
  details        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
